rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function hasNumber(data, field) {
      return field in data && data[field] is number;
    }

    function positiveAmount(data) {
      return hasNumber(data, 'amount') && data.amount > 0;
    }

    function validTransaction(data) {
      return positiveAmount(data)
        && (!('type' in data) || data.type in ['income', 'expense', 'sell'])
        && (!('date' in data) || data.date is string)
        && (!('accountId' in data) || data.accountId is string);
    }

    function validTransfer(data) {
      return positiveAmount(data)
        && (!('date' in data) || data.date is string)
        && (!('fromAccountId' in data) || data.fromAccountId is string)
        && (!('toAccountId' in data) || data.toAccountId is string);
    }

    function validAccount(data) {
      return (!('balance' in data) || data.balance is number)
        && (!('quantity' in data) || data.quantity is number)
        && (!('buyPrice' in data) || data.buyPrice is number)
        && (!('openingRate' in data) || data.openingRate is number)
        && (!('creditLimit' in data) || data.creditLimit is number)
        && (!('currency' in data) || data.currency in ['TRY', 'USD', 'EUR', 'GRAM_ALTIN', 'CEYREK_ALTIN'])
        && (!('type' in data) || data.type is string)
        && (!('name' in data) || data.name is string);
    }

    function validGoal(data) {
      return (!('amount' in data) || (data.amount is number && data.amount > 0))
        && (!('target' in data) || (data.target is number && data.target > 0))
        && (!('current' in data) || (data.current is number && data.current >= 0));
    }

    function validBudget(data) {
      return (!('amount' in data) || (data.amount is number && data.amount >= 0))
        && (!('limit' in data) || (data.limit is number && data.limit >= 0));
    }

    function validNotification(data) {
      return (!('key' in data) || data.key is string)
        && (!('title' in data) || data.title is string)
        && (!('message' in data) || data.message is string)
        && (!('icon' in data) || data.icon is string)
        && (!('read' in data) || data.read is bool)
        && (!('deleted' in data) || data.deleted is bool)
        && (!('ts' in data) || data.ts is number)
        && (!('deletedAt' in data) || data.deletedAt is number);
    }

    function validPushToken(data) {
      return (!('platform' in data) || data.platform is string)
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // Kullanıcı profili: rol ve oluşturulma tarihi kullanıcı tarafından ele geçirilemez.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp);

      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'currency',
            'currentMonth',
            'selectedAccounts',
            'themeColor',
            'privacyModeEnabled',
            'lastLoginAt'
          ])
        );

      allow delete: if isAdmin();

      match /accounts/{doc} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) && validAccount(request.resource.data)) || isAdmin();
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /transactions/{doc} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) && validTransaction(request.resource.data)) || isAdmin();
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /transfers/{doc} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) && validTransfer(request.resource.data)) || isAdmin();
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /recurringTransactions/{doc} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) && positiveAmount(request.resource.data)) || isAdmin();
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /goals/{doc} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) && validGoal(request.resource.data)) || isAdmin();
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /budgets/{doc} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) && validBudget(request.resource.data)) || isAdmin();
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /categories/{doc} {
        allow read, delete: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.type in ['income', 'expense'])
          || isAdmin();
      }

      match /notifications/{doc} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) && validNotification(request.resource.data)) || isAdmin();
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /pushTokens/{doc} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) && validPushToken(request.resource.data)) || isAdmin();
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /pushLog/{doc} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }
    }
  }
}
